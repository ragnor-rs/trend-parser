# --- Required ---

# Telegram Bot Token, from https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key

# Pinecone API Key
PINECONE_API_KEY=your_pinecone_api_key

# Pinecone index name. The index is created automatically if it does not exist.
PINECONE_INDEX_NAME=design-trends

# --- Optional ---

# Region for the Pinecone index, used only when it has to be created.
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Models. Override these if your OpenAI account lacks access to the defaults.
# ANSWER_MODEL=gpt-4o
# TRANSLATION_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-large

# Must match the output size of EMBEDDING_MODEL
# (3072 for text-embedding-3-large, 1536 for text-embedding-3-small).
# EMBEDDING_DIMENSIONS=3072

# How many articles to use as context for one answer.
# TOP_K=5
